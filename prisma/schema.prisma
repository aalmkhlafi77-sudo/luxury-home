// Prisma Schema for Luxury Home Platform (منزل الفخامة)
// Database: PostgreSQL 16
// High-precision financial accounting, strict booking allocation, and full multi-property management

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  PROPERTY_MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  MAINTENANCE
  ACCOUNTANT
  TENANT
}

enum RentalType {
  DAILY
  MONTHLY
  ANNUAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum InstallmentStatus {
  UPCOMING
  PAID
  OVERDUE
  PARTIALLY_PAID
}

enum ExpenseCategoryType {
  BUILDING_RENT
  ADMIN_SALARIES
  BUILDING_STAFF_SALARIES
  ADVERTISING_MARKETING
  UTILITIES_ELECTRICITY
  UTILITIES_WATER
  INTERNET_TELECOM
  CLEANING_SUPPLIES
  BUILDING_COMMON_MAINTENANCE
  UNIT_APPLIANCES_MAINTENANCE
  GOVERNMENT_FEES_LICENSES
  PAYMENT_FEES_COMMISSIONS
  FURNITURE_APPLIANCES
  OPERATIONS_OTHER
}

enum CostCenterLevel {
  COMPANY
  PROPERTY
  UNIT
}

enum TemporalDistributionType {
  NONE
  MONTHLY_PRORATED
  ANNUAL_PRORATED
  CUSTOM_PERIOD
}

enum CostAllocationMethod {
  DIRECT_UNIT
  EQUAL_UNITS
  SQM_AREA
  REVENUE_RATIO
  OCCUPANCY_DAYS
  CUSTOM_RATIO
}

model User {
  id                String      @id @default(uuid())
  username          String      @unique
  email             String      @unique
  passwordHash      String
  name              String
  phone             String?
  role              Role        @default(TENANT)
  allowedProperties String[]    @default(["all"])
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  auditLogs         AuditLog[]
}

model CompanySettings {
  id              String   @id @default("default")
  companyName     String   @default("Luxury home منزل الفخامة")
  companyNameEn   String   @default("Luxury Home")
  tagline         String   @default("تجربة سكنية فاخرة تدمج بين خصوصية المنزل وخدمات الضيافة الراقية")
  logoUrl         String?
  iconUrl         String?
  phone           String   @default("+966 11 000 0000")
  whatsapp        String   @default("+966 50 000 0000")
  email           String   @default("vip@luxuryhome.sa")
  crNumber        String   @default("1010000000")
  taxNumber       String   @default("300000000000003")
  nationalAddress String   @default("الرياض - المملكة العربية السعودية")
  checkInTime     String   @default("15:00")
  checkOutTime    String   @default("12:00")
  navigation      Json?
  themeConfig     Json?
  updatedAt       DateTime @updatedAt
}

model Property {
  id              String      @id @default(uuid())
  name            String
  code            String      @unique
  address         String
  city            String      @default("الرياض")
  district        String
  floorsCount     Int         @default(1)
  unitsCount      Int         @default(0)
  totalAreaSqm    Float       @default(0)
  rooftopPayment  Decimal     @default(0) @db.Decimal(12, 2)
  description     String?
  images          String[]
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  floors          Floor[]
  units           Unit[]
  parkingSpots    ParkingSpot[]
  expenses        OperationalExpense[]
  documents       DocumentRecord[]
}

model Floor {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number      Int
  name        String
  units       Unit[]

  @@unique([propertyId, number])
}

model Unit {
  id                        String         @id @default(uuid())
  propertyId                String
  property                  Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floorId                   String?
  floor                     Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  unitNumber                String
  title                     String         @default("")
  titleEn                   String         @default("")
  type                      String         // apartment, studio, suite, duplex
  areaSqm                   Float          @default(0)
  floorNumber               Int            @default(1)
  maxGuests                 Int            @default(3)
  bedroomsCount             Int            @default(1)
  bathroomsCount            Int            @default(1)
  bedsCount                 Int            @default(1)
  furnishingStatus          String         @default("furnished") // furnished, partially_furnished, unfurnished
  allowDaily                Boolean        @default(true)
  dailyRate                 Decimal        @default(0) @db.Decimal(12, 2)
  dailySecurityDeposit      Decimal        @default(0) @db.Decimal(12, 2)
  allowMonthly              Boolean        @default(true)
  monthlyRate               Decimal        @default(0) @db.Decimal(12, 2)
  monthlySecurityDeposit    Decimal        @default(0) @db.Decimal(12, 2)
  allowYearly               Boolean        @default(true)
  annualRate                Decimal        @default(0) @db.Decimal(12, 2)
  yearlySecurityDeposit     Decimal        @default(0) @db.Decimal(12, 2)
  yearlyPaymentOptions      String[]       @default(["single_annual", "semi_annual"])
  semiAnnualSurchargePercent Decimal       @default(0) @db.Decimal(5, 2)
  cleaningFee               Decimal        @default(0) @db.Decimal(12, 2)
  securityDeposit           Decimal        @default(0) @db.Decimal(12, 2)
  taxPercentage             Decimal        @default(15) @db.Decimal(5, 2)
  operationalStatus         String         @default("ready") // ready, occupied, cleaning, maintenance, blocked
  occupancyStatus           String         @default("vacant") // vacant, occupied, maintenance, blocked
  isClean                   Boolean        @default(true)
  publicationStatus         String         @default("published") // draft, published, archived
  amenities                 String[]       @default([])
  images                    String[]       @default([])
  media                     Json?
  spaces                    Json?
  fittings                  Json?
  floorPlanUrl              String?
  assignedParkingId         String?
  notes                     String?
  smartLockPin              String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  
  allocations       UnitAllocation[]
  bookings          Booking[]
  leases            Lease[]
  expenses          OperationalExpense[]
  expenseShares     ExpenseAllocation[]

  @@unique([propertyId, unitNumber])
}

model Amenity {
  id          String   @id
  name        String
  nameEn      String
  icon        String
  category    String   @default("general")
}

model ParkingSpot {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  spotNumber      String
  floor           String
  hasEVCharger    Boolean  @default(false)
  status          String   @default("vacant")
  assignedUnitId  String?

  @@unique([propertyId, spotNumber])
}

model UnitAllocation {
  id          String      @id @default(uuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  rentalType  RentalType
  referenceId String?     // Booking or Lease ID
  purpose     String      // booking, lease, maintenance, block
  status      String      @default("active") // active, released, cancelled
  notes       String?
  createdAt   DateTime    @default(now())

  @@index([unitId, startDate, endDate, status])
}

model Booking {
  id                String        @id @default(uuid())
  bookingNumber     String        @unique
  idempotencyKey    String?       @unique
  unitId            String
  unit              Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guestName         String
  guestPhone        String
  guestEmail        String?
  guestIdNumber     String?
  userId            String?
  startDate         DateTime
  endDate           DateTime
  rentalType        RentalType    @default(DAILY)
  totalNights       Int           @default(1)
  guestsCount       Int           @default(1)
  nightlyRate       Decimal       @default(0) @db.Decimal(12, 2)
  subtotal          Decimal       @default(0) @db.Decimal(12, 2)
  cleaningFee       Decimal       @default(0) @db.Decimal(12, 2)
  taxes             Decimal       @default(0) @db.Decimal(12, 2)
  securityDeposit   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  status            BookingStatus @default(CONFIRMED)
  paymentStatus     String        @default("pending") // pending, paid_cash, paid_online, partial
  identityStatus    String        @default("pending_verification") // pending_verification, verified, rejected
  smartLockPin      String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments          PaymentRecord[]
  securityDeposits  SecurityDepositRecord[]
}

model Lease {
  id                String      @id @default(uuid())
  contractNumber    String      @unique
  idempotencyKey    String?     @unique
  unitId            String
  unit              Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantName        String
  tenantPhone       String
  tenantEmail       String?
  tenantIdNumber    String
  startDate         DateTime
  endDate           DateTime
  rentalType        RentalType  @default(ANNUAL)
  annualRent        Decimal     @db.Decimal(12, 2)
  paymentOption     String      // 1 payment, 2 payments, 4 payments, monthly
  paymentFrequency  String?     // '1_payment', '2_payments', 'monthly'
  installmentsCount Int         @default(1)
  securityDeposit   Decimal     @default(0) @db.Decimal(12, 2)
  contractServices  Json?
  includedAmenities String[]
  termsConditions   String?
  status            LeaseStatus @default(ACTIVE)
  pdfUrl            String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  installments      LeaseInstallment[]
  securityDeposits  SecurityDepositRecord[]
  payments          PaymentRecord[]
  targetDepositTransactions SecurityDepositTransaction[] @relation("LeaseTargetDepositTransactions")
}

model LeaseInstallment {
  id              String            @id @default(uuid())
  leaseId         String
  lease           Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  number          Int
  label           String?           // e.g. "الدفعة الأولى"
  dueDate         DateTime
  amount          Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal           @db.Decimal(12, 2)
  status          InstallmentStatus @default(UPCOMING)
  paidAt          DateTime?

  payments        PaymentRecord[]
  targetDepositTransactions SecurityDepositTransaction[] @relation("InstallmentTargetDepositTransactions")
}

model PaymentRecord {
  id            String    @id @default(uuid())
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  leaseId       String?
  lease         Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  installmentId String?
  installment   LeaseInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    // cash, card, bank_transfer, mada, apple_pay, security_deposit
  sourceType    String?   @default("direct_payment") // direct_payment, deposit_application, reversal
  affectsCash   Boolean   @default(true)
  receiptNo     String?
  referenceNo   String?
  status        String    @default("completed") // completed, pending, refunded
  isVerified    Boolean   @default(false)
  paidAt        DateTime  @default(now())
  notes         String?
}

model SecurityDepositRecord {
  id                   String    @id @default(uuid())
  leaseId              String?
  lease                Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  bookingId            String?
  booking              Booking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amount               Decimal   @db.Decimal(12, 2)
  collectedAmount      Decimal   @default(0) @db.Decimal(12, 2)
  collectionReference  String?
  collectionVerifiedAt DateTime?
  status               String    @default("held") // held, pending_refund, refunded, partially_refunded, deducted
  deductedAmount       Decimal   @default(0) @db.Decimal(12, 2)
  refundedAmount       Decimal   @default(0) @db.Decimal(12, 2)
  rentAppliedAmount    Decimal   @default(0) @db.Decimal(12, 2)
  deductionReason  String?
  refundMethod     String?   // bank_transfer, gateway_reversal, cash
  refundReference  String?
  refundType       String?   // actual_payout, preauth_release
  refundedByUserId String?
  refundedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  transactions     SecurityDepositTransaction[]
}

model SecurityDepositTransaction {
  id                  String                @id @default(uuid())
  depositId           String
  deposit             SecurityDepositRecord @relation(fields: [depositId], references: [id], onDelete: Cascade)
  type                String                // refund, deduction, preauth_release, rent_application
  amount              Decimal               @db.Decimal(12, 2)
  method              String                // bank_transfer, gateway_reversal, cash, mada, security_deposit
  reference           String                // Payment receipt / transfer reference
  reason              String?
  targetLeaseId       String?
  targetLease         Lease?                @relation("LeaseTargetDepositTransactions", fields: [targetLeaseId], references: [id], onDelete: SetNull)
  targetInstallmentId String?
  targetInstallment   LeaseInstallment?     @relation("InstallmentTargetDepositTransactions", fields: [targetInstallmentId], references: [id], onDelete: SetNull)
  executedByUserId    String?
  executedAt          DateTime              @default(now())
  status              String                @default("completed") // completed, pending_provider
  idempotencyKey      String?               @unique
  notes               String?
  createdAt           DateTime              @default(now())

  @@index([depositId])
}

model OperationalExpense {
  id                  String                   @id @default(uuid())
  expenseNumber       String                   @unique
  title               String
  amount              Decimal                  @db.Decimal(12, 2)
  costCenterLevel     CostCenterLevel
  propertyId          String?
  property            Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId              String?
  unit                Unit?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  categoryCode        ExpenseCategoryType
  subcategory         String?
  expenseDate         DateTime                 @default(now())
  startDate           DateTime
  endDate             DateTime
  temporalType        TemporalDistributionType @default(NONE)
  allocationMethod    CostAllocationMethod     @default(EQUAL_UNITS)
  status              String                   @default("approved") // draft, pending, approved, reversed
  isCapitalAsset      Boolean                  @default(false) // FF&E vs OPEX
  notes               String?
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  allocations         ExpenseAllocation[]
  payments            ExpensePaymentEntry[]
}

model ExpenseAllocation {
  id          String             @id @default(uuid())
  expenseId   String
  expense     OperationalExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  shareAmount Decimal            @db.Decimal(12, 2)
  percentage  Float
  monthPeriod String             // e.g., "2026-10"
}

model ExpensePaymentEntry {
  id            String             @id @default(uuid())
  expenseId     String
  expense       OperationalExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount        Decimal            @db.Decimal(12, 2)
  paymentDate   DateTime           @default(now())
  paymentMethod String
  referenceNo   String?
  notes         String?
}

model ExpenseCategoryConfig {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  nameAr                  String
  nameEn                  String
  costCenterLevel         CostCenterLevel
  temporalDistribution    TemporalDistributionType
  defaultAllocationMethod CostAllocationMethod
  subcategories           String[]
  isActive                Boolean                  @default(true)
}

model RecurringExpenseSchedule {
  id          String          @id @default(uuid())
  title       String
  categoryCode ExpenseCategoryType
  amount      Decimal         @db.Decimal(12, 2)
  propertyId  String?
  unitId      String?
  frequency   String          // monthly, quarterly, annual
  nextDueDate DateTime
  isActive    Boolean         @default(true)
}

model TenantAdjustment {
  id          String   @id @default(uuid())
  tenantName  String
  unitNumber  String
  type        String   // discount, penalty, fee
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  date        DateTime @default(now())
  approvedBy  String
}

model ContentSection {
  id        String   @id
  title     String
  subtitle  String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  config    Json?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String
  module    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id            String   @id @default(uuid())
  key           String
  operationType String   // batch_units_create, booking_create, refund
  userId        String?
  requestHash   String   // SHA-256 fingerprint
  statusCode    Int      @default(200)
  responseBody  Json
  createdAt     DateTime @default(now())

  @@unique([key, operationType])
  @@index([key, operationType, userId])
}

model DocumentRecord {
  id           String    @id @default(uuid())
  fileName     String    @unique
  originalName String
  fileSize     Int       @default(0)
  mimeType     String?
  isPrivate    Boolean   @default(true)
  ownerUserId  String?
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId       String?
  bookingId    String?
  leaseId      String?
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([propertyId])
  @@index([ownerUserId])
}
