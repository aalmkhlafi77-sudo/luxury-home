# =========================================================
# Template Environment Variables File (.env.example)
# Copy to .env and configure before starting production container
# =========================================================

# --- Server & Core Settings ---
NODE_ENV=production
PORT=3000
APP_DOMAIN=https://your-domain.com
API_BASE_URL=https://your-domain.com/api

# --- Database & Cache ---
# PostgreSQL Connection String (Prisma format)
DATABASE_URL=postgresql://ivoire_user:IvoireSecurePass2026@localhost:5432/ivoire_db?schema=public

# Redis Connection String for background jobs and sessions
REDIS_URL=redis://localhost:6379

# --- Security & JWT ---
JWT_SECRET=replace_with_a_long_secure_random_hash_string_min_32_chars
SUPER_ADMIN_INITIAL_USERNAME=admin
SUPER_ADMIN_INITIAL_PASSWORD=SetSecurePassword2026!

# --- File Storage & Uploads ---
UPLOAD_STORAGE_TYPE=local # local | s3 | gcs
UPLOAD_DIR=/app/uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- External Services Integration (Optional / Configurable) ---
# 1. Payment Gateway (Moyasar / Mada / Tap)
PAYMENT_PROVIDER=moyasar
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# 2. Smart Locks (Tuya / TTLock API)
SMART_LOCK_PROVIDER=tuya
SMART_LOCK_API_KEY=
SMART_LOCK_SECRET_KEY=

# 3. Government & Identity Verification (Yakeen / Absher)
YAKEEN_APP_ID=
YAKEEN_APP_KEY=

# 4. SMS & WhatsApp Notifications (Taqnyat / Twilio)
SMS_PROVIDER=taqnyat
SMS_API_KEY=
SMS_SENDER_NAME=IVOIRE
