# =========================================================
# Luxury Home (منزل الفخامة) - Environment Configuration Template
# Copy this file to .env and configure all required variables
# =========================================================

# --- 1. Core Runtime & Server Settings ---
NODE_ENV=production
PORT=3000
APP_DOMAIN=https://luxuryhome.sa
API_BASE_URL=https://luxuryhome.sa/api

# --- 2. Database (PostgreSQL 16) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://luxury_home_user:strong_custom_password_here@postgres:5432/luxury_home_db?schema=public

# --- 3. Redis Cache & Job Queues ---
REDIS_URL=redis://redis:6379

# --- 4. Security, JWT & Administrative Setup ---
# Long cryptographic secret for signing JSON Web Tokens (min 32 chars)
JWT_SECRET=generate_a_random_64_character_hex_string_for_production
# Initial Super Admin setup credentials (used once to seed initial admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ReplaceWithStrongPassword2026!
INITIAL_ADMIN_EMAIL=admin@luxuryhome.sa

# --- 5. Media & Storage Paths ---
UPLOAD_STORAGE_TYPE=local
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups

# --- 6. External Integrations (Optional - System works with manual fallback) ---
# Payment Gateway (Moyasar / HyperPay / Tap)
PAYMENT_PROVIDER=moyasar
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# Smart Locks Integration (Tuya / TTLock)
SMART_LOCK_PROVIDER=tuya
SMART_LOCK_API_KEY=
SMART_LOCK_SECRET_KEY=

# Identity Verification (Yakeen / Absher)
YAKEEN_APP_ID=
YAKEEN_APP_KEY=

# SMS Gateway (Taqnyat / Unifonic)
SMS_PROVIDER=taqnyat
SMS_API_KEY=
SMS_SENDER_NAME=LUXURYHOME
